Cell[TextData[{
 "Now write out my equation with \[Theta]1 and \[Theta]2 swapped.  My coded \
equation \[Theta]I$code is really ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "I"], "/", 
    SubscriptBox["\[Epsilon]", "s"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a84ec2a-d32d-459f-a6f2-2eba4ac43bed"],
 ", as note above.\nSubstitute for the variables p1 through p7."
}], "Text",
