Cell[TextData[{
 "So let us implement ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "I"], TraditionalForm]],ExpressionUUID->
  "213e2441-a090-4e80-aef1-6d2081366ef0"],
 " as (we are leaving out the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "s"], "/", 
    SubscriptBox["\[Epsilon]", "eff"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6839126e-7fc5-4544-97b9-e17247c1fd43"],
 " prefactor here)"
}], "Text",
 CellChangeTimes->{{3.904199342284851*^9, 3.90419935202071*^9}, {
  3.9041994020787487`*^9, 3.904199415607147*^9}, {3.904472559363854*^9, 
  3.904472565844047*^9}, {3.904472624694305*^9, 
  3.904472673792637*^9}},ExpressionUUID->"1b73d55e-609d-41a2-96a6-\
8a231f7b42c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]I", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Lambda]"}], " ", 
     RowBox[{"Coth", "[", "\[Theta]2", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
        RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], "+", " ", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], "-", "\[Lambda]", "+", 
       RowBox[{"2", " ", 
        RowBox[{"\[Lambda]", " ", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
           RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}], ")"}]}]}], "-", 
       RowBox[{
        SuperscriptBox["\[Lambda]", "2"], " ", 
        RowBox[{
         RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cosh", "[", "\[Theta]2", "]"}], " ", 
           RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], ")"}]}]}]}], " ", ")"}],
      "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Tanh", "[", "\[Theta]2", "]"}], "+", 
       RowBox[{
        RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], "+", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}], ")"}]}]}], 
      ")"}]}]}]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.904199426637088*^9, 3.9041994896626062`*^9}, {
  3.904471119720701*^9, 3.9044711281865463`*^9}, {3.904472517600608*^9, 
  3.904472531362507*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"27800a56-f55a-4149-9005-75a2049fc0fa"],

Cell["Expand the denominator", "Text",
 CellChangeTimes->{{3.90448126701437*^9, 
  3.904481280721579*^9}},ExpressionUUID->"0f01e3d4-e888-4235-b334-\
9e89cae92d28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Tanh", "[", "\[Theta]2", "]"}], "+", 
   RowBox[{
    RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "\[Lambda]"}], "+", 
      RowBox[{"\[Alpha]", " ", 
       RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}], ")"}]}]}], " ", "//", " ",
   "Expand"}]], "Input",
 CellChangeTimes->{{3.9044812838125067`*^9, 3.904481285207696*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"c2e6ceec-f9a4-444e-b557-19a0eabc9b4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "\[Lambda]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}]}], "+", 
  RowBox[{"Tanh", "[", "\[Theta]2", "]"}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}]], "Output",
 CellChangeTimes->{3.90448128631001*^9, 3.994180527911518*^9, 
  3.9941959802205887`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"98c5957f-6ec6-4a13-9598-0fb3cdcc057b"]
}, Open  ]],

Cell["Check that this expression agrees with what we started with.", "Text",
 CellChangeTimes->{{3.9041994922601337`*^9, 
  3.904199507309278*^9}},ExpressionUUID->"f97b3811-7bc6-42f4-9f1b-\
0fd4bb3d8f0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]I", " ", "-", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Lambda]"}], " ", 
      RowBox[{"Coth", "[", "\[Theta]2", "]"}]}], "+", 
