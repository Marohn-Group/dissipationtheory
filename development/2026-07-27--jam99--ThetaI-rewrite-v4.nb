Notebook[{
Cell[TextData[{
 StyleBox["2026-07-27--jam99--ThetaI-rewrite-v4.nb\n",
  FontWeight->"Bold"],
 "\nJohn A . Marohn (jam99@cornell.edu)\n2026-07-28\n\nConfirm that \
Lekkala2013 Equation 17, rewritten, agrees with the equation I have coded in \
Python."
}], "Text",
 CellChangeTimes->{{3.9942001471450567`*^9, 
  3.994200260923079*^9}},ExpressionUUID->"75ee2642-ede6-4022-9e13-\
ee59d3b0bc63"],

Cell[CellGroupData[{

Cell["From 2023-09-23--jam99--ThetaI-rewrite-v2.nb", "Section",
 CellChangeTimes->{{3.994180590167181*^9, 
  3.994180615173514*^9}},ExpressionUUID->"b8fbeea1-b184-4684-a45c-\
e7731576e80f"],

Cell[TextData[{
 "We wish to rewrite  Equation 17 in Lekkala2013, ",
 StyleBox["J. Chem. Phys.",
  FontSlant->"Italic"],
 " (2013) 139:184702.  \nWrite out the numerator and denominator in \
Lekkala2013 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "I"], TraditionalForm]],ExpressionUUID->
  "dd46a5f3-fe8e-4fee-a571-d9066fdb5681"],
 " separately, with \[Theta]1 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", " ", 
    SubscriptBox["h", "s"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6e910ac4-3444-4c50-ace3-03ba5c54fd1c"],
 " and \[Theta]2 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", " ", 
    SubscriptBox["h", "s"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a06df59b-cbd6-4e9a-a3be-1de58979fec0"],
 ".\nLekkala writes\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Theta]", "I"], "(", 
     RowBox[{"k", ",", "\[Omega]"}], ")"}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["\[Epsilon]", "s"], "(", "\[Omega]", ")"}], 
      RowBox[{
       SubscriptBox["\[Epsilon]", "eff"], "(", "\[Omega]", ")"}]], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "\[Lambda]"}], " ", 
       RowBox[{"Coth", "[", "\[Theta]1", "]"}]}], " ", "+", " ", 
      FractionBox["numerator", "denominator"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9a39bb0-98aa-445b-a430-6d704d357ef7"],
 "\n\t\nBelow we rewrite the part in braces.  In my code, I compute\n\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["\[Theta]", "I"], "(", 
      RowBox[{"k", ",", "\[Omega]"}], ")"}], 
     RowBox[{
      SubscriptBox["\[Epsilon]", "s"], "(", "\[Omega]", ")"}]], " ", "=", " ", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SubscriptBox["\[Epsilon]", "eff"], "(", "\[Omega]", ")"}]], "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", " ", "\[Lambda]"}], " ", 
       RowBox[{"Coth", "[", "\[Theta]1", "]"}]}], " ", "+", " ", 
      FractionBox["numerator", "denominator"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e9b507a-f7b8-41c9-8631-daa716284579"],
 "\t\n\t\nwhich we recognize as the part in braces divided by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "eff"], "(", "\[Omega]", ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8796d515-54e8-4ced-8053-970ec4e795a2"],
 "."
}], "Text",
 CellChangeTimes->{{3.904197881477676*^9, 3.904197951332725*^9}, {
  3.904197981462809*^9, 3.904197983993826*^9}, {3.994195109305644*^9, 
  3.994195177796496*^9}, {3.9941952150845757`*^9, 3.994195504459837*^9}, {
  3.994195679025064*^9, 3.994195733055418*^9}, {3.99419579312152*^9, 
  3.994195928190352*^9}, {3.994200025523191*^9, 
  3.994200029323695*^9}},ExpressionUUID->"a029055f-6987-46a4-a247-\
a01a47b9ebc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numerator", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Sinh", "[", "\[Theta]1", "]"}], " ", 
    RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
   RowBox[{"\[Alpha]", " ", 
    RowBox[{"Cosh", "[", "\[Theta]1", "]"}], 
    RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], "-", " ", 
   RowBox[{"\[Lambda]", " ", 
    RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
    RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
   RowBox[{"2", " ", "\[Lambda]"}], " ", "-", " ", 
   RowBox[{
    SuperscriptBox["\[Lambda]", "2"], " ", 
    FractionBox[
     RowBox[{"Sinh", "[", "\[Theta]1", "]"}], 
     RowBox[{"Sinh", "[", "\[Theta]2", "]"}]]}]}]}]], "Input",
 CellChangeTimes->{{3.904195895008482*^9, 3.9041959837125387`*^9}, {
  3.90447057667642*^9, 3.904470601836646*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"b32149d5-5079-4d8f-8679-856f049b7a1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", "\[Lambda]"}], "-", 
  RowBox[{"\[Lambda]", " ", 
   RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["\[Lambda]", "2"], " ", 
   RowBox[{"Csch", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]1", "]"}]}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], "+", 
  RowBox[{
   RowBox[{"Sinh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.904195984380735*^9, {3.9044706413702297`*^9, 3.904470670186117*^9}, 
   3.904470782067011*^9, 3.9044725780030937`*^9, 3.994180527558515*^9, 
   3.994195979926667*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"6385b461-30a1-4275-8142-fd6b547d092d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"denominator", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
    RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], " ", "+", 
   RowBox[{"\[Alpha]", " ", 
    RowBox[{"Sinh", "[", "\[Theta]1", "]"}], 
    RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], "-", " ", 
   RowBox[{"\[Lambda]", " ", 
    RowBox[{"Sinh", "[", "\[Theta]1", "]"}], " ", 
    RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9041959893732357`*^9, 3.9041960294241123`*^9}, {
   3.904470612928892*^9, 3.9044706225482903`*^9}, 3.904470778663525*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"abbf8aec-650a-4441-ac96-c6e8dfe3bf3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "\[Lambda]"}], " ", 
   RowBox[{"Cosh", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]1", "]"}]}], "+", 
  RowBox[{
   RowBox[{"Cosh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"Sinh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Sinh", "[", "\[Theta]2", "]"}]}]}]], "Output",
 CellChangeTimes->{
  3.904196030498661*^9, {3.904470652411541*^9, 3.9044706702912693`*^9}, {
   3.904470779355494*^9, 3.9044707821432753`*^9}, 3.9044725781653433`*^9, 
   3.9941805276232*^9, 3.994195979995376*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"f001ba59-5fe5-4f73-aea8-00089a4e6540"]
}, Open  ]],

Cell["\<\
Divide the denominator by Cosh[\[Theta]] to see if that tames the \[Theta]1 \
divergence.  \
\>", "Text",
 CellChangeTimes->{{3.904198209473797*^9, 
  3.9041982381368217`*^9}},ExpressionUUID->"5911cb9a-a9bc-4faa-978b-\
c62b693ad6e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["denominator", 
   RowBox[{"Cosh", "[", "\[Theta]1", "]"}]], " ", "//", " ", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.904197064497663*^9, 3.9041970660387373`*^9}, 
   3.9044707384767857`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"54c341f7-993f-49fd-b5a4-4319947c9278"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sinh", "[", "\[Theta]2", "]"}], "-", 
  RowBox[{"\[Lambda]", " ", 
   RowBox[{"Cosh", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}]}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"Sinh", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}]}]}]], "Output",
 CellChangeTimes->{3.904197066529923*^9, 3.90447067068172*^9, 
  3.904470739397868*^9, 3.904470782299275*^9, 3.904470814981103*^9, 
  3.9044725781992407`*^9, 3.994180527643816*^9, 3.994195980010832*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"79b681ee-4da0-4a46-b754-67c928d13d91"]
}, Open  ]],

Cell["It does ...", "Text",
 CellChangeTimes->{{3.904198240931348*^9, 
  3.904198267904667*^9}},ExpressionUUID->"edf1ac00-8169-4f17-a328-\
96e8305305c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Tanh", "[", "\[Theta]1", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9041971163275833`*^9, 3.9041971336195993`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"d7d29120-3e06-4c9e-a213-ef1fe4dc7d4c"],

