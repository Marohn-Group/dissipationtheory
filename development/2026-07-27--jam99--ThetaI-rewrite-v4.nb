Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]I$code", " ", "=", " ", 
   RowBox[{
    RowBox[{"p1", " ", 
     RowBox[{"Coth", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"p2", " ", 
       RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
       RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
      RowBox[{"p3", " ", 
       RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], " ", "+", " ", "p4", " ", 
      "-", " ", 
      RowBox[{"2", " ", "p4", " ", 
       RowBox[{"Sech", "[", "\[Theta]1", "]"}], 
       RowBox[{"Sech", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
      RowBox[{"p5", " ", 
       RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
       RowBox[{"Sech", "[", "\[Theta]2", "]"}], " ", 
       RowBox[{"Csch", "[", "\[Theta]2", "]"}]}]}], 
     RowBox[{
      RowBox[{"p6", " ", 
       RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Tanh", "[", "\[Theta]1", "]"}], 
       RowBox[{"(", 
        RowBox[{"p1", " ", "+", " ", 
         RowBox[{"p7", " ", 
          RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}], ")"}]}]}]]}]}], " ", 
  ";"}]], "Input",
