Cell["Try dividing the denominator by Cosh[\[Theta]1]Cosh[\[Theta]2].", "Text",
 CellChangeTimes->{{3.904198332936737*^9, 3.9041983590228863`*^9}, {
  3.904470985997232*^9, 
  3.9044709890135317`*^9}},ExpressionUUID->"d6b788bf-e993-4f16-b7e2-\
97632c212b7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["denominator", 
   RowBox[{
    RowBox[{"Cosh", "[", "\[Theta]1", "]"}], 
    RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}]], " ", "//", " ", 
  "Simplify"}]], "Input",
 CellChangeTimes->{
  3.904198317377193*^9, {3.9041987836304073`*^9, 3.90419878673358*^9}, {
   3.904470869810252*^9, 3.904470871234682*^9}, {3.9044709171383142`*^9, 
   3.904470917756102*^9}, {3.904470954534274*^9, 3.9044709614061537`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"edb6926b-7c56-4e0a-8a07-e927944ed267"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Tanh", "[", "\[Theta]2", "]"}], "+", 
  RowBox[{
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[Lambda]"}], "+", 
     RowBox[{"\[Alpha]", " ", 
      RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{
  3.904198318368367*^9, 3.904470670779592*^9, 3.9044707824159117`*^9, 
