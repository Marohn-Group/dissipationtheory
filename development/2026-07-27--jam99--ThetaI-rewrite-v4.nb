Cell["\<\
Now, by inspection, both the \[Theta]1 and \[Theta]2 functions in the \
denominator are well-behaved.  What about the numerator?\
\>", "Text",
 CellChangeTimes->{{3.904198387225828*^9, 
  3.904198420356881*^9}},ExpressionUUID->"251cda6b-bccf-4a18-b773-\
8e2871504f0f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["numerator", 
   RowBox[{
    RowBox[{"Cosh", "[", "\[Theta]1", "]"}], 
    RowBox[{"Cosh", "[", "\[Theta]2", "]"}]}]], " ", "//", " ", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.904198426646881*^9, 3.904198430583963*^9}, {
  3.9044709052016582`*^9, 3.904470906179326*^9}, {3.904470997121084*^9, 
  3.904470997543068*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"27a50f09-a802-4f4d-a3a2-01d706720de7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "\[Lambda]"}], "+", 
  RowBox[{"2", " ", "\[Lambda]", " ", 
   RowBox[{"Sech", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Sech", "[", "\[Theta]2", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["\[Lambda]", "2"], " ", 
   RowBox[{"Csch", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Sech", "[", "\[Theta]2", "]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}]}], "+", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], "+", 
  RowBox[{
   RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
   RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9041984314675694`*^9, 3.904470670801021*^9, 
  3.904470782443411*^9, 3.904470906907241*^9, 3.9044710012780724`*^9, 
  3.9044725785857563`*^9, 3.994180527817528*^9, 3.994195980133202*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"a16d450a-d0ed-421a-a28a-59bd7cf9dc18"]
}, Open  ]],

Cell["\<\
All three \[Theta]2 functions in the numerator are ok at large \[Theta]2.  \
But one of them diverges at small \[Theta]2, which is a problem.\
\>", "Text",
 CellChangeTimes->{{3.9041984916624317`*^9, 
  3.904198564056081*^9}},ExpressionUUID->"6e8108a5-1f15-4852-b343-\
18f86502942b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sech", "[", "\[Theta]2", "]"}], ",", 
     RowBox[{
      RowBox[{"Csch", "[", "\[Theta]2", "]"}], " ", 
      RowBox[{"Sech", "[", "\[Theta]2", "]"}]}], ",", 
     RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]2", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input",
