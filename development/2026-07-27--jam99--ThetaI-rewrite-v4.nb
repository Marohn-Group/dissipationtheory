Cell[TextData[{
 "The argument \[Theta]2 = \[Eta] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     StyleBox["s",
      FontSlant->"Plain"]], " "}], TraditionalForm]],ExpressionUUID->
  "b6345a97-7eff-43d3-b5cb-b2bdd05ffb93"],
 "in the paper, and \[Eta] does not go to zero.  So, in practice, I think the \
function Csch[\[Theta]2] Sech[\[Theta]2] should be ok."
}], "Text",
 CellChangeTimes->{{3.90419881667337*^9, 
  3.904198918449214*^9}},ExpressionUUID->"fce3cc55-bb0d-404e-8232-\
e69cb71659cd"],

Cell[TextData[{
 "In summary, write the big fraction ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "I"], TraditionalForm]],ExpressionUUID->
  "e07c0800-39cf-4aa3-9b6c-9ad84d122b5d"],
 " as follows"
}], "Text",
 CellChangeTimes->{{3.9041989211311502`*^9, 3.90419895171568*^9}, {
  3.9041990245816183`*^9, 
  3.904199035844906*^9}},ExpressionUUID->"7f4aec05-7306-4ecf-b449-\
6d162d76dbcb"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"-", "\[Lambda]"}], "+", 
    RowBox[{"2", " ", "\[Lambda]", " ", 
     RowBox[{"Sech", "[", "\[Theta]1", "]"}], " ", 
     RowBox[{"Sech", "[", "\[Theta]2", "]"}]}], "-", 
    RowBox[{
     SuperscriptBox["\[Lambda]", "2"], " ", 
     RowBox[{"Csch", "[", "\[Theta]2", "]"}], " ", 
     RowBox[{"Sech", "[", "\[Theta]2", "]"}], " ", 
     RowBox[{"Tanh", "[", "\[Theta]1", "]"}]}], "+", 
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
     RowBox[{"Tanh", "[", "\[Theta]2", "]"}], " "}]}], 
   RowBox[{
    RowBox[{"Tanh", "[", "\[Theta]2", "]"}], "+", 
    RowBox[{
     RowBox[{"Tanh", "[", "\[Theta]1", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "\[Lambda]"}], "+", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"Tanh", "[", "\[Theta]2", "]"}]}]}], ")"}]}]}]], " ", 
  ";"}]], "Input",
 CellChangeTimes->{{3.904198955965405*^9, 3.904199081881558*^9}, {
  3.904471070800394*^9, 3.904471082082255*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"50e09b39-315e-475d-8efa-68ee6f96e83a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Tanh", "[", "\[Theta]2", "]"}], ",", 
     RowBox[{"Sech", "[", "\[Theta]2", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]2", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input",
